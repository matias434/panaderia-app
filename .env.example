PORT=3000

# Configuración recomendada en Railway o con PostgreSQL remoto:
DATABASE_URL=postgres://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS

# Alternativa para una base PostgreSQL local (usar si no se define DATABASE_URL):
# DB_USER=postgres
# DB_PASSWORD=tu_contrasena
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=panaderia
