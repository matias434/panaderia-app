PORT=3000

# Configuración recomendada en Railway o con PostgreSQL remoto:
DATABASE_URL=postgres://USUARIO:CONTRASENA@HOST:PUERTO/BASE_DE_DATOS

# Alternativa para una base PostgreSQL local (usar si no se define DATABASE_URL):
# DB_USER=postgres
# DB_PASSWORD=tu_contrasena
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=panaderia

# Acceso de proveedores (reemplazar por PINs privados de 4 a 12 dígitos):
PROVIDER_PIN_RODRIGO=REEMPLAZAR
PROVIDER_PIN_ELSA=REEMPLAZAR
PROVIDER_PIN_MARCOS=REEMPLAZAR

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROVIDER_SESSION_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_64_CARACTERES

# Acceso de Secretaría (PIN privado de 4 a 12 dígitos y secreto independiente):
SECRETARY_PIN=REEMPLAZAR
SECRETARY_SESSION_SECRET=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_DE_64_CARACTERES
